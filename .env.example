# ── App ─────────────────────────────────────────────
APP_NAME="MathKnot API"
APP_VERSION="0.1.0"
ENVIRONMENT="local"          # local | staging | production
DEBUG=true

# ── Database (Postgres) ─────────────────────────────
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="mathknot"
POSTGRES_PASSWORD="mathknot"
POSTGRES_DB="mathknot"

# ── JWT ─────────────────────────────────────────────
# 운영에서는 반드시 교체할 것:  openssl rand -hex 32
JWT_SECRET_KEY="dev-only-secret-change-me-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
